<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Login Fragment -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.testapp.fragments.LoginFragment"
        android:label="התחברות"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <!-- Register Fragment -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.testapp.fragments.RegisterFragment"
        android:label="הרשמה"
        tools:layout="@layout/fragment_register" />

    <!-- Home Fragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.testapp.fragments.HomeFragment"
        android:label="ביתי"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_home_to_courts"
            app:destination="@id/courtsFragment" />
        <action
            android:id="@+id/action_home_to_teams"
            app:destination="@id/teamsFragment" />
        <action
            android:id="@+id/action_home_to_allCourtsView"
            app:destination="@id/allCourtsViewFragment" />
        <action
            android:id="@+id/action_home_to_manageUsers"
            app:destination="@id/manageUsersFragment" />
        <action
            android:id="@+id/action_home_to_schedule"
            app:destination="@id/scheduleFragment" />
        <action
            android:id="@+id/action_home_to_scheduleGrid"
            app:destination="@id/scheduleGridFragment" />
        <action
            android:id="@+id/action_home_to_playerDetails"
            app:destination="@id/playerDetailsFragment" />
    </fragment>

    <!-- Courts Fragment -->
    <fragment
        android:id="@+id/courtsFragment"
        android:name="com.example.testapp.fragments.CourtsFragment"
        android:label="מגרשים"
        tools:layout="@layout/fragment_courts" >
        <action
            android:id="@+id/action_courts_to_addEditCourt"
            app:destination="@id/addEditCourtFragment" />
    </fragment>

    <!-- Add/Edit Court Fragment -->
    <fragment
        android:id="@+id/addEditCourtFragment"
        android:name="com.example.testapp.fragments.AddEditCourtFragment"
        android:label="ניהול מגרש"
        tools:layout="@layout/fragment_add_edit_court" >
        <argument
            android:name="courtId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Teams Fragment -->
    <fragment
        android:id="@+id/teamsFragment"
        android:name="com.example.testapp.fragments.TeamsFragment"
        android:label="קבוצות"
        tools:layout="@layout/fragment_teams" >
        <action
            android:id="@+id/action_teams_to_teamPlayers"
            app:destination="@id/teamPlayersFragment" />
    </fragment>

    <!-- Team Players Fragment -->
    <fragment
        android:id="@+id/teamPlayersFragment"
        android:name="com.example.testapp.fragments.TeamPlayersFragment"
        android:label="שחקני קבוצה"
        tools:layout="@layout/fragment_team_players" >
        <argument
            android:name="teamId"
            app:argType="string" />
        <argument
            android:name="teamName"
            app:argType="string" />
        <argument
            android:name="team"
            app:argType="com.example.testapp.models.Team"
            app:nullable="true" />
        <action
            android:id="@+id/action_teamPlayers_to_addPlayers"
            app:destination="@id/addPlayersFragment" />
        <action
            android:id="@+id/action_teamPlayers_to_playerDetails"
            app:destination="@id/playerDetailsFragment" />
    </fragment>

    <!-- Add Players Fragment -->
    <fragment
        android:id="@+id/addPlayersFragment"
        android:name="com.example.testapp.fragments.AddPlayersFragment"
        android:label="הוסף שחקנים"
        tools:layout="@layout/fragment_add_players" >
        <argument
            android:name="teamId"
            app:argType="string" />
        <argument
            android:name="teamName"
            app:argType="string" />
    </fragment>

    <!-- Player Details Fragment -->
    <fragment
        android:id="@+id/playerDetailsFragment"
        android:name="com.example.testapp.fragments.PlayerDetailsFragment"
        android:label="פרטי שחקן"
        tools:layout="@layout/fragment_player_details" >
        <argument
            android:name="userId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="playerId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="teamId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Schedule Fragment -->
    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.example.testapp.fragments.ScheduleFragment"
        android:label="לוח אימונים"
        tools:layout="@layout/fragment_schedule" >
        <action
            android:id="@+id/action_schedule_to_addTraining"
            app:destination="@id/addTrainingFragment" />
        <action
            android:id="@+id/action_schedule_to_editTraining"
            app:destination="@id/editTrainingFragment" />
    </fragment>

    <!-- Add Training Fragment -->
    <fragment
        android:id="@+id/addTrainingFragment"
        android:name="com.example.testapp.fragments.AddTrainingFragment"
        android:label="אימון חדש"
        tools:layout="@layout/fragment_add_training" />

    <!-- Edit Training Fragment -->
    <fragment
        android:id="@+id/editTrainingFragment"
        android:name="com.example.testapp.fragments.EditTrainingFragment"
        android:label="עריכת אימון"
        tools:layout="@layout/fragment_edit_training" >
        <argument
            android:name="trainingId"
            app:argType="string" />
    </fragment>

    <!-- All Courts View Fragment -->
    <fragment
        android:id="@+id/allCourtsViewFragment"
        android:name="com.example.testapp.fragments.AllCourtsViewFragment"
        android:label="לוח מגרשים"
        tools:layout="@layout/fragment_all_courts_view" />

    <!-- Schedule Grid Fragment - New visual scheduling interface -->
    <fragment
        android:id="@+id/scheduleGridFragment"
        android:name="com.example.testapp.fragments.ScheduleGridFragment"
        android:label="תזמון אימונים חכם"
        tools:layout="@layout/fragment_schedule_grid" />

    <!-- Manage Users Fragment -->
    <fragment
        android:id="@+id/manageUsersFragment"
        android:name="com.example.testapp.fragments.ManageUsersFragment"
        android:label="ניהול משתמשים"
        tools:layout="@layout/fragment_manage_users" />

    <!-- Player Details Fragment - Removed because PlayerDetailsActivity is an Activity, not a Fragment -->

</navigation>